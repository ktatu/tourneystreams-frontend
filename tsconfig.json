// AI-assisted by Claude Sonnet 5.5 (GitHub Copilot): set moduleResolution to bundler and removed ignoreDeprecations for the Vite/TypeScript 5.9 migration.
{
    "compilerOptions": {
        "target": "es5",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "types": ["node", "youtube"]
    },
    "include": ["src", "custom.d.ts"]
}
